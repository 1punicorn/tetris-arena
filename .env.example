# Optional server settings only. Local use needs no .env file.
# Add providers, API keys and model IDs from the Settings screen.
# PORT=4317
# SETTINGS_DB=data/settings.sqlite
# RESULTS_DIR=results

# Optional public demo: lock matches to exactly two registered models and make
# all settings read-only. Use saved connection IDs or unique API model IDs.
# Leave unset/empty for normal local use. Restart after changing this value.
# DEMO_MODELS=jev,deepseek/deepseek-v4.1-flash

# One-time import from an older installation (optional):
# CONNECTIONS_FILE=connections.local.json

# HTTPS deployment / access control: docs/deployment.md
# Prefer a private systemd service.env for deployment-only settings.
# Optional cloud IAM / ADC credentials remain supported by the official SDKs.

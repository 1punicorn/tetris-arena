# Fill only the credentials your chosen connection profiles need.
# Keys stay on the local Node server. Never commit this file as .env.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AZURE_OPENAI_API_KEY=
# Bedrock: use the official SDK's AWS credentials or bearer API-key support.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# Vertex: set up Application Default Credentials, or an apiKeyEnv in the profile.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Local application settings (optional)
# PORT=4317
# CONNECTIONS_FILE=connections.local.json
# RESULTS_DIR=results

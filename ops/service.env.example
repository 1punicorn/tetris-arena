# Keep the real service.env private (chmod 600), outside the repository.
PORT=4317
# Exact private IP on which the HTTPS proxy can reach this machine:
HOST=192.168.1.20
PUBLIC_ORIGIN=https://arena.example.com
# Actual socket source address of your HTTPS reverse proxy; not X-Forwarded-For:
TRUSTED_PROXY_IP=192.168.1.1
PUBLIC_USERNAME=owner
# Set a unique random password of at least 16 characters before starting.
PUBLIC_PASSWORD=
# Only if you intentionally allow anyone to run models using your server keys:
# PUBLIC_ACCESS=true
# Optional fixed-model demo with read-only settings (register both models first):
# DEMO_MODELS=jev,deepseek/deepseek-v4.1-flash
